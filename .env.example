# ChainReaction Environment Variables
# Polyglot NoSQL Configuration

# MongoDB (Document Database)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chainreaction

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainreaction123

# Redis (Key-Value / Pub-Sub / Cache)
REDIS_URI=redis://localhost:6379/0

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Optional GitHub Token (to increase GitHub API rate limits for scanning)
GITHUB_TOKEN=
